{"action_space":"even candidate gaps 2..256 plus overflow","baseline_orderings":"neural, random, grammar-order, structural heuristic, validation oracle","candidate_enumerator":"enumerate every gap action before gating; no verifier pruning in enumeration","certificate_checker":"algebraic certificate such as gcd(modulus, residue) > 1 proves rejected candidate is composite","exact_verifier":"segmented sieve returns the true next-prime gap and exact verifier work","gate_executor":"accepted predicates reject impossible gaps before neural residual scoring","generalization_axis":"train on smaller prime ranges; test on larger prime ranges and larger gap coverage","leakage_policy":"exact divisibility and next-prime facts may be labels, rewards, certificates, or gates, but not default scorer inputs","neural_scorer":"shared MLP scores one state/action row and softmax ranks surviving candidates","observable_features":"minimal default [log(p), normalized_gap, overflow_flag]; residue flags are leakage ablations","proposer_inputs":"structural rule descriptors only: kind, moduli, residues, zero indicators, gcd ratios","proposer_targets":"empirical support and verifier utility predicted from train/validation labels, never used as proposer features","replay_protocol":"stable action-id JSONL traces train replay successors with parent checkpoint hashes","rl_protocol":"supervised scorer, strict verifier policy gradient, and KL/entropy-regularized verifier policy gradient","role":"compact arithmetic action-ranking benchmark for certified gate discovery","rule_grammar":"modular rejection predicates over candidate residues and optional state-conditioned residues","schema":"crlp.experiment_schema.v1","schema_version":1,"source_target":"experiment-schemas","state_distribution":"deterministic prime stream split into train, validation, and held-out ranges","state_space":"prime p below the task split limit","task":"prime_gap","trace_schema":"crlp.trace.v1","verifier_feedback":"target gap, top-k correctness, ranking loss, exact probes, calibration bins"}
{"action_space":"four moves: up, right, down, left","baseline_orderings":"neural, random, grammar-order, structural heuristic, validation oracle","candidate_enumerator":"enumerate all four moves, including blocked and out-of-bounds moves, before gating","certificate_checker":"finite validation/exhaustive geometry checks prove a rule never rejects an optimal move","exact_verifier":"BFS identifies shortest-path successors and verifier node cost","gate_executor":"accepted predicates remove impossible or certified non-optimal moves before neural scoring","generalization_axis":"train on generated grids and test shifted obstacle densities, start/goal distances, and grid seeds","leakage_policy":"explicit legality flags and BFS distances are verifier labels/costs, not scorer inputs","neural_scorer":"shared MLP scores one grid/action row and softmax ranks surviving moves","observable_features":"start/goal coordinates, candidate displacement, obstacle map, and action one-hot","proposer_inputs":"structural rule descriptors: rule kind, direction, boundary relation, cell relation, distance relation","proposer_targets":"reject support and verifier-cost savings predicted from train/validation labels","replay_protocol":"stable action-id JSONL traces train replay successors with parent checkpoint hashes","rl_protocol":"supervised scorer, strict verifier policy gradient, and KL/entropy-regularized verifier policy gradient","role":"spatial shortest-path action-ranking benchmark for certified pruning outside arithmetic","rule_grammar":"legality and admissible-pruning predicates over grid boundary, blocked cells, and distance bounds","schema":"crlp.experiment_schema.v1","schema_version":1,"source_target":"experiment-schemas","state_distribution":"deterministic grid generator split by train, validation, and held-out seed ranges","state_space":"7x7 obstacle grid with start and goal coordinates","task":"grid_path","trace_schema":"crlp.trace.v1","verifier_feedback":"target move, correctness, utility, candidate count, BFS nodes, calibration bins"}
{"action_space":"trust, ignore, request_more_evidence, act_cautiously","baseline_orderings":"neural, random, grammar-order, structural heuristic, validation oracle","candidate_enumerator":"enumerate all four actions for every claim state","certificate_checker":"exhaustive finite-generator check proves a rule never rejects any optimal action on the certified support","exact_verifier":"deterministic hidden rule computes action utilities and the best action","gate_executor":"accepted predicates remove dominated or unsafe actions before neural residual scoring","generalization_axis":"train on one seed band and evaluate shifted seed bands plus harder uncertainty bands","leakage_policy":"hidden truth resolution and action utilities may be verifier labels/rewards only","neural_scorer":"shared MLP scores one claim/action row and softmax ranks actions","observable_features":"observable claim features plus action one-hot; hidden outcome and utilities are excluded","proposer_inputs":"structural predicate descriptors: feature index, threshold bucket, action id, polarity","proposer_targets":"empirical utility/support and false-rejection diagnostics predicted from verifier labels","replay_protocol":"stable action-id JSONL traces train replay successors with soft and hard target weights","rl_protocol":"supervised scorer, strict verifier policy gradient, and KL/entropy-regularized verifier policy gradient","role":"finite delayed-feedback decision task for trace replay and verifier-RL calibration","rule_grammar":"threshold, dominance, and evidence-sufficiency predicates over observable features","schema":"crlp.experiment_schema.v1","schema_version":1,"source_target":"experiment-schemas","state_distribution":"fixed train/test seed ranges over the same hidden-rule generator","state_space":"six observable claim/evidence features generated from a deterministic simulator","task":"delayed_claim","trace_schema":"crlp.trace.v1","verifier_feedback":"target action, utility, proposal steps, calibration bins, replay loss"}
