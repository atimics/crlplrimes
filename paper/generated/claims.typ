sults/2026-05-17-multitask-roadmap/rmt7_arc_gate_invariance_summary.csv", chart_kind: "coverage_bar", chart_rows: ((label: "ARC train", value: 1187, certified_tasks: 24), (label: "ARC eval", value: 187, certified_tasks: 4))), (id: "C1.arc_public_evidence_surface", family: "C1", status: "supported", required: true, title: "Public ARC corpus parity row is measured and scoped", summary: "public ARC evidence surface improves from v10 eval 4 tasks/187 cells to v15_measured eval 7 tasks/1057 cells; v15_measured train remains 24 tasks/1187 cells.", explanation: "This is not a broad ARC-performance claim. It is the public-corpus parity row: the compiler can now distinguish measured ARC gate coverage, version-to-version movement, and the much larger unresolved residual.", source: "results/2026-05-17-arc-evidence-surface/arc_evidence_summary.csv", chart_kind: "coverage_bar", chart_rows: ((label: "v10 eval", value: 187, certified_tasks: 4), (label: "v12 eval", value: 207, certified_tasks: 5), (label: "v15_measured eval", value: 1057, certified_tasks: 7))), (id: "C3.arc_ood_calibration_tradeoff", family: "C3", status: "supported", required: true, title: "ARC shared scorer has a fixed-task versus OOD calibration tradeoff", summary: "ARC shared scorer is a calibration tradeoff: fixed-task NLL improves (4.0827 vs 8.2754) while ECE worsens (0.6995 vs 0.5589); OOD improves both NLL (2.6278 vs 4.3723) and ECE (0.4481 vs 0.4820).", explanation: "The calibration claim is explicitly conditional: shared training is not simply better calibrated everywhere. It is worse on fixed ARC ECE but better on OOD ECE, while improving log loss in both settings.", source: "results/2026-05-17-multitask-roadmap/rmt5_calibration_summary.csv", chart_kind: "delta_bar", chart_rows: ((label: "fixed ARC", value: -14.058685999999998, nll_improvement: 4.192744733333334), (label: "ARC OOD", value: 3.387266666666666, nll_improvement: 1.7444806199999991))), (id: "C4.delayed_claim_sibling_transfer", family: "C4", status: "supported", required: true, title: "Delayed-claim transfer gain is sibling-specific", summary: "delayed_claim all-domain top-1 98.00% vs claim-only 96.60% (+1.40pp); removing grid_path falls to 97.20%, while removing ARC rises to 98.50%.", explanation: "This replaces the earlier broad positive-transfer claim with a narrower one: delayed_claim benefits from shared training in this envelope, grid_path appears to be the helpful sibling, and ARC is mild interference.", source: "results/2026-05-17-multitask-roadmap/rmt3_leave_one_out.csv", chart_kind: "delta_bar", chart_rows: ((label: "all", value: 1.4000000000000123, top1: 0.98), (label: "no_prime_gap", value: 1.233333333333353, top1: 0.9783333333333334), (label: "no_grid_path", value: 0.6000000000000116, top1: 0.972), (label: "no_arc_agi", value: 1.9000000000000128, top1: 0.985), (label: "claim_only", value: 0.0, top1: 0.9659999999999999))), (id: "C4.multitask_capacity_tradeoff", family: "C4", status: "supported", required: true, title: "Capacity sweep does not explain away the ARC fixed-task gap", summary: "capacity sweep rules out a simple wider-is-better ARC story: best fixed-ARC shared row is 32x16 at 39.20%, but every shared ARC row trails single-task; delayed_claim deltas remain +0.10pp to +0.43pp.", explanation: "This keeps the architecture roadmap disciplined: capacity changes the ARC gap, but does not monotonically close it, so adapters or ordering should not be claimed until the tiny-net plateau check is done.", source: "results/2026-05-17-multitask-roadmap/rmt6_capacity_sweep_deltas.csv", chart_kind: "delta_bar", chart_rows: ((label: "32x16", value: -1.2333333333333418, arc_shared_top1: 0.39199999999999996, arc_single_top1: 0.4043333333333334, claim_delta_pp: 0.4333333333333522), (label: "64x32", value: -16.633333333333333, arc_shared_top1: 0.26166666666666666, arc_single_top1: 0.428, claim_delta_pp: 0.10000000000000009), (label: "128x64", value: -14.266666666666673, arc_shared_top1: 0.26166666666666666, arc_single_top1: 0.4043333333333334, claim_delta_pp: 0.13333333333332975), (label: "256x128", value: -8.300000000000002, arc_shared_top1: 0.345, arc_single_top1: 0.428, claim_delta_pp: 0.43333333333333))), (id: "C5.rejected_candidate_reason_learning", family: "C5", status: "supported", required: true, title: "Rejected-candidate reasons repair proposer ranking on prime/modular gates", summary: "reason learning repairs the prime proposer failure at budget 8: model_score selects 7 unsafe rows and causes 172 validation false rejections, while reason_prior reaches 6 accepted rules/216.0 utility and trained_residual reaches 7 accepted rules/245.0 utility with zero false rejections; prime/modular split sweeps pass, but delayed_claim has 0 mixed split rows.", explanation: "This is the first substrate-level self-authoring loop: rejected verifier rows are converted into reasons, then those reasons improve the next proposer pass. The claim is scoped to the prime/modular sweeps; delayed_claim remains a stress case. Seed-interval and reason-family artifacts are reported when present so the paper can distinguish stable proposer repair from a single favorable trace.", source: "results/2026-05-17-substrate-extensions/rejected_candidate_reason_learning.jsonl", chart_kind: "coverage_bar", chart_rows: ((label: "model_score", value: 0.0, false_rejections: 172, unsafe_rules: 7), (label: "reason_prior", value: 216.0, false_rejections: 0, unsafe_rules: 0), (label: "reason_aware", value: 210.0, false_rejections: 0, unsafe_rules: 0), (label: "trained_residual", value: 245.0, false_rejections: 0, unsafe_rules: 0))), (id: "C5.hypothesis_library_promotion", family: "C5", status: "supported", required: true, title: "Certified hypothesis libraries feed back into proposal ranking", summary: "certified-library promotion supports fixture-level feedback: promoted move_to_anchor from 2 tasks/78 covered events with zero false rejections; slot priors raise learned certified@1 from 2 to 4 and utility@8 from 0.2119 to 0.5169. Held-out split feedback rows: 30.", explanation: "This makes the hypothesis library a generated claim rather than a roadmap note. Fixture feedback and held-out feedback are separated in machine-readable rows; public ARC promotion remains the R-S.1c gap before using it as a headline ARC claim.", source: "results/2026-05-17-substrate-extensions/hypothesis_library_promotions.jsonl", chart_kind: "coverage_bar", chart_rows: ((label: "no_prior", value: 2, utility_at_8: 0.21186440678), (label: "slot_prior", value: 4, utility_at_8: 0.516949152542))), (id: "C7.tiny_net_plateau_stop_rule", family: "C7", status: "underpowered", required: false, title: "Tiny-net architecture claims are gated by plateau audits", summary: "tiny-net plateau audit covers 4 capacities across 4 domains; 10/16 shared rows meet the plateau threshold, and ARC shared width verdict picks 16x8 as best hidden.", explanation: "This turns the width discussion into an audit: the paper can distinguish undertraining from representation limits using learning curves, restarts, best checkpoints, parameter counts, FLOPs, plateau flags, and width-help rows.", source: "results/2026-05-17-multitask-roadmap/tiny_net_plateau_summary.jsonl", chart_kind: "coverage_bar", chart_rows: ((label: "16x8", value: 41.63333333333334, domain: "arc_agi", plateau_detected: false), (label: "32x16", value: 39.199999999999996, domain: "arc_agi", plateau_detected: false), (label: "64x32", value: 26.166666666666664, domain: "arc_agi", plateau_detected: true), (label: "8x4", value: 39.233333333333334, domain: "arc_agi", plateau_detected: false))), (id: "C8.trace_determinism_audit", family: "C8", status: "supported", required: true, title: "Trace replay semantics are deterministic across float and double runs", summary: "trace determinism audit covers 2 traces and 2000 rows; invalid_rows=0, rank_fp_sensitive_rows=0, logged_mismatches=0, semantic_hashes_equal=True.", explanation: "The reproducibility claim is semantic rather than bit-exact: float and double runs may differ in logits and calibration diagnostics, but the replay-semantic trace projection has the same hash and exposes every rank-sensitive row.", source: "results/latest/trace_determinism.jsonl", chart_kind: "coverage_bar", chart_rows: ((label: "float", value: 1000, rank_fp_sensitive_rows: 0, invalid_rows: 0), (label: "double", value: 1000, rank_fp_sensitive_rows: 0, invalid_rows: 0))), (id: "C9.signal_flight_replay_control", family: "C9", status: "supported", required: true, title: "Signal replay-certified WASD ranker improves held-out control utility", summary: "Signal offline replay ranker top-1 79.76% vs baseline 67.86% (+11.90pp), utility 0.1432 vs 0.1359, regret 0.0073 vs 0.0146, damage 2.38% vs 2.38%, deaths 0.00% vs 0.00%; live shadow frames=22191.", explanation: "This is an application vignette, not a live-control claim: Signal contributes a replay-certified bounded-control surface where the neural component ranks nine WASD candidates and simulator replay owns the outcome labels.", source: "results/2026-05-17-signal-flight/summary.jsonl", chart_kind: "coverage_bar", chart_rows: ((label: "baseline", value: 67.8571429, regret: 0.014589607), (label: "neural", value: 79.76190480000001, regret: 0.007348488))))

